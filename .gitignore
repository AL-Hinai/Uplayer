node_modules/

# Run logs are never committed. Write them to a logs/ dir next to whatever produced them
# (bench/logs/, scripts/data/logs/) rather than scattering them through the source tree —
# both patterns below are already covered by *.log, this is the placement convention.
*.log
logs/
.DS_Store
.env
*.torrent
dist/

# Benchmarks are LOCAL ONLY — the whole directory is untracked, harnesses and reports
# included. It held 23 tracked files up to V1.34; they were removed from the index (the
# files stay on disk) and nothing under bench/ goes into a commit again.
#
# Why: a benchmark is a measurement of one machine, one network and one evening. Its
# numbers go stale without any code changing, the reports are long and get rewritten
# wholesale on every run, and a stale committed report read with confidence is worse than
# no report — the same reasoning docs/ARCHITECTURE.md gives for re-verifying its own line
# citations. Conclusions worth keeping belong in the docs that outlive a run.
#
# Consequence to be aware of: the `bench:*` scripts in package.json reference files that a
# fresh clone will not have, so they only work in a checkout where someone has written them.
bench/

# Root-level vendored prebuilt binaries (TorrServer, alass, whisper + models) — large,
# regenerable via scripts/setup-torrserver.js and scripts/setup-subtitle-tools.js.
# Leading slash so this does NOT match public/vendor/ (committed player libs: Video.js, JASSUB).
/vendor/

# Temporary streaming files
.temp/
*.tmp
stream-sandbox-*/

# Torrent-naming research harness — regenerable artifacts.
# We commit the human-readable report, machine summary, and the small
# baseline test result, but ignore the raw 6 MB corpus, the 26 MB TMDB
# response cache, and the latest test-results dump (regenerated each run).
scripts/data/cache/
scripts/data/torrent-naming-data.json
scripts/data/test-results.json

# System temp directories (for reference)
# /tmp/webtorrent (cleaned automatically)
# /dev/shm/stream-sandbox-* (RAM-based, auto-cleaned)

# Build artifacts (the debug APK is copied into the repo root by the Android build)
*.apk
*.aab

# Note: android-app/ has its own .gitignore covering Gradle/IDE caches, the regenerated
# bundled Node app (app/src/main/assets/nodejs-project/ — a node_modules copy + .env),
# the large prebuilt native libs (jniLibs/, nodejs-mobile headers — fetched per
# android-app/BUILD.md), and keystores.







truso.env

# (Generated benchmark JSON used to be listed here, alongside a note that bench/*.md and
# the *-archive.* files stayed tracked. The whole of bench/ is ignored now — see the rule
# near the top of this file — so those entries were redundant and the note was wrong.)
