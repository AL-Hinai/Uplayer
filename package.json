{
  "name": "uplayer",
  "version": "0.17.0",
  "description": "Uplayer - Simple CLI torrent player. Just search and play movies instantly using TorrServer",
  "main": "uplayer.js",
  "bin": {
    "uplayer": "./uplayer.js"
  },
  "scripts": {
    "start": "node uplayer.js",
    "start:bun": "bun run uplayer.js",
    "web": "node server.js",
    "test": "node tests/run-all.js",
    "test:core": "node tests/core-services.test.js",
    "test:recommendations": "node tests/recommendation-engine.test.js",
    "test:api-contract": "node tests/api-contract.test.js",
    "test:lifecycle": "node tests/stream-lifecycle.test.js",
    "test:media-facts": "node tests/media-facts.test.js",
    "test:stream-health": "node tests/stream-health.test.js",
    "test:playback-target": "node tests/playback-target.test.js",
    "test:vlc-progress": "node tests/vlc-progress.test.js",
    "test:player-link": "node tests/open-active-player.test.js",
    "test:player-html": "node tests/native-player-html.test.js",
    "test:subtitle-extract": "node tests/subtitle-extract.test.js",
    "test:stream-hub": "node tests/stream-hub.test.js",
    "test:cast-tv": "node tests/cast-tv-modal.test.js",
    "test:dlna-ready": "node tests/dlna-background-ready.test.js",
    "test:dlna-payload": "node tests/dlna-cast-payload.test.js",
    "test:dlna-recovery": "node tests/dlna-cast-recovery.test.js",
    "test:next-episode": "node tests/next-episode.test.js",
    "test:trackers": "node tests/magnet-trackers.test.js",
    "test:history-progress": "node tests/history-progress.test.js",
    "test:quality": "node tests/quality-ranking.test.js",
    "test:vlc-link": "node tests/open-vlc-target.test.js",
    "test:playback-strategy": "node tests/playback-strategy.test.js",
    "test:cast-diagnose": "node tests/cast-diagnose.test.js",
    "cast-diagnose": "node tools/cast-diagnose.js",
    "bench:stream-speed": "node bench/stream-speed.js",
    "build": "pkg . --out-path dist",
    "build:all": "pkg . --targets node18-linux-x64,node18-win-x64,node18-macos-x64 --out-path dist",
    "build:linux": "pkg . --targets node18-linux-x64 --out-path dist",
    "build:win": "pkg . --targets node18-win-x64 --out-path dist",
    "build:macos": "pkg . --targets node18-macos-x64 --out-path dist",
    "install:bun": "bun install",
    "install:npm": "npm install",
    "build:android-assets": "node scripts/build-android-assets.js",
    "setup:torrserver": "node scripts/setup-torrserver.js",
    "setup:torrserver:android": "node scripts/setup-torrserver.js android",
    "setup:subtitle-tools": "node scripts/setup-subtitle-tools.js",
    "setup:android-libs": "node scripts/setup-android-libs.js restore",
    "setup:android-libs:save": "node scripts/setup-android-libs.js save",
    "setup:android-libs:check": "node scripts/setup-android-libs.js check"
  },
  "keywords": [
    "torrserver",
    "streaming",
    "movies",
    "torrent",
    "cli"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "axios": "^1.6.0",
    "chalk": "^4.1.2",
    "cheerio": "^1.0.0-rc.12",
    "cli-progress": "^3.12.0",
    "commander": "^11.1.0",
    "express": "^4.22.1",
    "ffmpeg-static": "^5.2.0",
    "ffprobe-static": "^3.1.0",
    "inquirer": "^8.2.6",
    "open": "^8.4.2",
    "opensubtitles.com": "^1.1.0",
    "subtitle": "^4.2.2",
    "tmdb-js-node": "^1.3.2"
  },
  "devDependencies": {
    "node-pre-gyp": "^0.17.0",
    "pkg": "^5.8.1"
  },
  "pkg": {
    "assets": [
      "node_modules/ffmpeg-static/ffmpeg*",
      "node_modules/ffprobe-static/bin/**/*",
      "public/player/**/*",
      "public/vendor/**/*"
    ],
    "targets": [
      "node18-linux-x64",
      "node18-win-x64",
      "node18-macos-x64"
    ],
    "outputPath": "dist"
  }
}
