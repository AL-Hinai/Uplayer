<?xml version="1.0" encoding="utf-8"?>
<!-- Uplayer serves its UI and stream over plain HTTP on the device's loopback
     and LAN address, so cleartext must be permitted for those. -->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
        <!-- Private LAN ranges (for the cast/same-network URL). -->
        <domain includeSubdomains="true">10.0.0.0</domain>
        <domain includeSubdomains="true">192.168.0.0</domain>
        <domain includeSubdomains="true">172.16.0.0</domain>
    </domain-config>
    <!-- WebView loads localhost; allow cleartext app-wide as a fallback since the
         exact LAN IP is dynamic. Tighten if you prefer stricter policy. -->
    <base-config cleartextTrafficPermitted="true" />
</network-security-config>
